      "paper": {
        "arxiv_id": "openalex:W3212580602",
        "base_id": "openalex:W3212580602",
        "version": 1,
        "title": "Crossing the Reality Gap: A Survey on Sim-to-Real Transferability of Robot Controllers in Reinforcement Learning",
        "authors": [
          "Erica Salvato",
          "Gianfranco Fenu",
          "Eric Medvet",
          "Felice Andrea Pellegrino"
        ],
        "published": "2021-01-01T00:00:00Z",
        "updated": "2021-01-01T00:00:00Z",
        "primary_category": "",
        "categories": [],
        "summary": "The growing demand for robots able to act autonomously in complex scenarios has widely accelerated the introduction of Reinforcement Learning (RL) in robots control applications. However, the trial and error intrinsic nature of RL may result in long training time on real robots and, moreover, it may lead to dangerous outcomes. While simulators are useful tools to accelerate RL training and to ensure safety, they often are provided only with an approximated model of robot dynamics and of its interaction with the surrounding environment, thus resulting in what is called the reality gap (RG): a mismatch of simulated and real control-law performances caused by the inaccurate representation of the real environment in simulation. The most undesirable result occurs when the controller learnt in simulation fails the task on the real robot, thus resulting in an unsuccessful sim-to-real transfer. The goal of the present survey is threefold: (1) to identify the main approaches to face the RG problem in the context of robot control with RL, (2) to point out their shortcomings, and (3) to outline new potential research areas.",
        "abs_url": "https://doi.org/10.1109/access.2021.3126658",
        "pdf_url": "",
