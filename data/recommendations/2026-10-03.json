        "base_arxiv_id": null,
        "doi": "10.1109/tpami.2023.3339515",
        "title": "Bi-DexHands: Towards Human-Level Bimanual Dexterous Manipulation",
        "authors": [
          "Yuanpei Chen",
          "Yiran Geng",
          "Fangwei Zhong",
          "Jiaming Ji",
          "Jiechuang Jiang",
          "Zongqing Lu",
          "Hao Dong",
